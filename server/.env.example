# Copy to .env (or set these in your host's environment settings).
# Secrets — server only, never in the task pane:
FERGUS_API_TOKEN=          # Fergus → Settings → Personal Access Tokens
ANTHROPIC_API_KEY=         # console.anthropic.com → API keys

# Microsoft Entra ID app registration that protects this API (see README).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# AUTH_DISABLED=true       # local testing ONLY — skips sign-in entirely

# Business-unit groups Claude may suggest, comma-separated, exactly as named in Fergus.
FERGUS_GROUPS=
FERGUS_DEFAULT_JOB_TYPE=Quote        # Quote | Estimate | Charge Up

# Our own staff's email domains, so a forwarder isn't taken for the customer.
OWN_EMAIL_DOMAINS=citytimber.co.nz

# Optional
# PORT=3000
# DATA_DIR=./data                    # where actioned-emails.json is kept; must persist across restarts
# ALLOWED_ORIGINS=https://shop-star.github.io
# FERGUS_JOB_URL_TEMPLATE=https://app.fergus.com/jobs/view/{jobId}
# ANTHROPIC_MODEL=claude-opus-5-5
