// Cloudflare Worker for the "Create Fergus job" task pane.
// Secrets (FERGUS_API_TOKEN, ANTHROPIC_API_KEY) and FERGUS_GROUPS are set in
// the Cloudflare dashboard, never here: keep_vars stops a deploy removing them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fergus-job",
  "account_id": "3f7f939af57f5777b928190d7ddc3997",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },

  "vars": {
    "ENTRA_CLIENT_ID": "97a22ba4-8cd3-486f-88b2-6e7339a287ea",
    "ENTRA_TENANT_ID": "6fcef592-bbb9-493f-9b5d-c39253026214",
    "OWN_EMAIL_DOMAINS": "citytimber.co.nz",
    "FERGUS_DEFAULT_JOB_TYPE": "Quote",
    "ALLOWED_ORIGINS": "https://shop-star.github.io",
    // Adds this region's anniversary day to the public holidays put on the
    // Fergus calendar, e.g. "auckland" or "canterbury". Empty for national
    // holidays only. Choices are in src/holidays.js.
    "HOLIDAY_REGION": ""
  },

  // Monthly public-holiday sync (src/holiday-sync.js): 19:00 UTC on the 1st,
  // which is 7–8am on the 2nd in New Zealand.
  "triggers": { "crons": ["0 19 1 * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fergus-job",
      // From Cloudflare dashboard → Storage & Databases → D1 → fergus-job.
      "database_id": "cbad7075-615c-4f70-a397-016d0db2ff8e",
      "migrations_dir": "migrations"
    }
  ]
}
