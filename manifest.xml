<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
    xsi:type="MailApp">

  <!-- Unique identifier for this add-in. Do not change once you have sideloaded it,
       or Outlook will treat a later version as a brand new add-in. -->
  <Id>02e134bf-61e6-4889-b5f8-e8c87fc3ffd8</Id>
  <Version>2.2.0.0</Version>
  <ProviderName>City Timber</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Falcon Flooring" />
  <Description DefaultValue="Create a Fergus job from an email, or open the Surface Takeoff web app with its plan attachments and links." />

  <!-- Hosted via GitHub Pages at https://shop-star.github.io/falcon-outlook-addin -->
  <IconUrl DefaultValue="https://shop-star.github.io/falcon-outlook-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://shop-star.github.io/falcon-outlook-addin/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://shop-star.github.io/falcon-outlook-addin" />

  <AppDomains>
    <AppDomain>https://shop-star.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8" />
    </Sets>
  </Requirements>

  <!-- Schema-required legacy fallback for very old clients without
       VersionOverrides support. The real buttons are under VersionOverrides
       below. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://shop-star.github.io/falcon-outlook-addin/taskpane/fergus.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <!-- One group, so Outlook on the web shows both buttons under
                   "Falcon Flooring" rather than under the first group's label. -->
              <Group id="FalconFlooringGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="SurfaceTakeoffButton">
                  <Label resid="ButtonLabel" />
                  <Supertip>
                    <Title resid="ButtonLabel" />
                    <Description resid="ButtonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>openSurfaceTakeoffApp</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="CreateFergusJobButton">
                  <Label resid="FergusButtonLabel" />
                  <Supertip>
                    <Title resid="FergusButtonLabel" />
                    <Description resid="FergusButtonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="FergusTaskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://shop-star.github.io/falcon-outlook-addin/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://shop-star.github.io/falcon-outlook-addin/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://shop-star.github.io/falcon-outlook-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://shop-star.github.io/falcon-outlook-addin/commands.html" />
        <bt:Url id="FergusTaskpane.Url" DefaultValue="https://shop-star.github.io/falcon-outlook-addin/taskpane/fergus.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Falcon Flooring" />
        <bt:String id="ButtonLabel" DefaultValue="Surface Takeoff" />
        <bt:String id="FergusButtonLabel" DefaultValue="Create Fergus job" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTooltip" DefaultValue="Open the Surface Takeoff app in your browser, with this email's plan attachments and links ready to go." />
        <bt:String id="FergusButtonTooltip" DefaultValue="Turn this email into a Fergus job: check the customer, site and job details pulled from it, then create the job with the email attached as a note." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
